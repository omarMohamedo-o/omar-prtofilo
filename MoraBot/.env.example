# INTEGR8 AI Assistant - Environment Configuration
# Copy this file to .env and fill in your actual values

# ========================================
# REQUIRED API KEYS
# ========================================

# Google AI API Key (Required)
# Get your key from: https://ai.google.dev/
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Key (Required for voice features)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here



# ========================================
# OPTIONAL: FIREBASE CONFIGURATION
# (For audio file storage and sharing)
# ========================================

# Firebase API Key
FIREBASE_API_KEY=your_firebase_api_key

# Firebase Project ID
FIREBASE_PROJECT_ID=your_project_id

# Firebase Auth Domain
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# Firebase Database URL
FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com/

# Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# Firebase Messaging Sender ID
FIREBASE_MESSAGING_SENDER_ID=your_sender_id

# Firebase App ID
FIREBASE_APP_ID=1:your_sender_id:web:your_app_id

# Firebase Measurement ID (Optional)
FIREBASE_MEASUREMENT_ID=your_measurement_id

# Path to Firebase Service Account Key JSON file
FIREBASE_SERVICE_ACCOUNT=path/to/serviceAccountKey.json

# ========================================
# OPTIONAL: APPLICATION CONFIGURATION
# (These have defaults in config.py, override if needed)
# ========================================

# Model Configuration
# GEMINI_MODEL=gemini-1.5-flash
# EMBEDDING_MODEL=models/embedding-001
# TEMPERATURE=0.7
# MAX_OUTPUT_TOKENS=8192

# Database Configuration
# PERSIST_DIRECTORY=DB/
# SOURCE_DIRECTORY=SOURCE_DOCUMENTS/

# Processing Configuration
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200

# API Configuration
# API_HOST=0.0.0.0
# API_PORT=5110

# Voice Configuration
# WHISPER_MODEL_SIZE=small
# SPEECH_RATE=160

# ========================================
# NOTES
# ========================================
# 1. Never commit this file with real values to version control
# 2. Add .env to your .gitignore file
# 3. Rotate API keys regularly for security
# 4. Use environment-specific .env files for different deployments