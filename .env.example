# ============================================
# MORA Portfolio - Environment Variables
# Copy this file to .env and fill in values
# ============================================
#
# HTTP/HTTPS ports (default: 5050/8443)
# Use a non-default host port to avoid collisions (override with .env)
HTTP_PORT=5050
# - NEVER commit .env files with real values
# - Use GitHub Secrets for CI/CD deployments
# - Use Docker secrets or vault for production
#
# ============================================

# ==========================================
# Server Configuration
# ==========================================

# HTTP/HTTPS ports (default: 80/443)
# Use a non-default host port to avoid collisions (override with .env)
# (See top of this file for the host mapping used by Docker Compose)
HTTPS_PORT=8443

# Server name (use _ for any hostname, or your domain)
SERVER_NAME=_

# ==========================================
# Container Registry (for production)
# ==========================================

# Registry URL (e.g., ghcr.io, docker.io)
REGISTRY=ghcr.io

# Image prefix (your GitHub username/org)
IMAGE_PREFIX=your-github-username/mora-portfolio

# Image tag (latest, commit SHA, or version)
TAG=latest

# ==========================================
# Backend SMTP Configuration
# ==========================================

# SMTP server host
SMTP_HOST=smtp.gmail.com

# SMTP server port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Email recipient for discovery form
RECEIVER_EMAIL=your-email@example.com

# ==========================================
# Frontend Mailer Configuration (Discovery)
# ==========================================

# SendGrid API key for discovery emails
SENDGRID_API_KEY=

# Sender email address
FROM_EMAIL=no-reply@example.com

# Recipient email for discovery requests
TO_EMAIL=your-email@example.com

# Set true to test discovery submissions without sending email
TEST_EMAIL_MODE=false

# ==========================================
# SECRETS - Set via Docker secrets or CI/CD
# ==========================================
# These should NOT be set in this file for production!
# Use GitHub Secrets + docker-compose.production.yml instead.
#
# For LOCAL development only, you can set:
# SMTP_USER=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
# GOOGLE_API_KEY=your_google_api_key
# HF_TOKEN=your_huggingface_token
